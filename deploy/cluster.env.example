# Central API settings for a baseline of 40 concurrent student chat/RAG requests.
# Replica/GPU/machine count is independent; use the actual LAN inventory.
# Raise admission above 40 only after a full workload benchmark on target hardware.
# Set actual gateway private address reachable FROM the application container.
VLLM_URL=http://GATEWAY_PRIVATE_ADDRESS:8001/v1/chat/completions
MAX_CONCURRENT_CHATS=40
RETRIEVAL_BATCH_SIZE=8
RETRIEVAL_BATCH_WAIT_MS=8
RETRIEVAL_TIMEOUT=60
MAX_HISTORY_CHARS=4000
RAG_CONTEXT_TOKENS=1200
MAX_OUTPUT_TOKENS=1024
MAX_CONCURRENT_TTS=2
TTS_QUEUE_TIMEOUT=2

# Gateway bind is deliberately loopback by default. Set the trusted/private
# interface IP to make it reachable from the central application container/host.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8001
# Supply the SAME strong VLLM_API_KEY separately to API, fleet-health and all nodes.
# VLLM_MODEL_REVISION must be set on every inference node to one model commit hash.
