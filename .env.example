# Copy to .env, then replace every CHANGE_ME value. Never commit real credentials.
# Generate independent secrets: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS='[{"key":"CHANGE_ME_ADMIN_KEY_AT_LEAST_32_CHARS","subject":"instructor","role":"admin","courses":["metaverse"]},{"key":"CHANGE_ME_STUDENT_KEY_AT_LEAST_32_CHARS","subject":"student-001","role":"student","courses":["metaverse"]}]'
DATA_DIR=data
# For Docker this must be reachable FROM the container, not its own localhost.
# Point to the inference host on a trusted network, behind TLS when crossing hosts.
VLLM_URL=http://127.0.0.1:8000/v1/chat/completions
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=CHANGE_ME_INFERENCE_KEY
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=CHANGE_ME_DATABASE_KEY
QDRANT_COLLECTION=teacher_courses_v1

MAX_CONCURRENT_CHATS=4
REQUESTS_PER_MINUTE=60
LLM_TIMEOUT=90
MAX_OUTPUT_TOKENS=1024
MAX_HISTORY_CHARS=12000
MAX_UPLOAD_BYTES=10485760
MAX_PENDING_JOBS=50

RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set model commit hashes for reproducibility; blank revisions use upstream defaults.
# RAG_EMBEDDING_REVISION=<Hugging Face model commit>
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANKER_REVISION=<Hugging Face model commit>
RAG_RERANK_ENABLED=true
RAG_DEVICE=cpu
RAG_CHUNK_TOKENS=256
RAG_CHUNK_OVERLAP=40
RAG_RETRIEVE_K=20
RAG_TOP_K=5
RAG_CONTEXT_TOKENS=1800
RAG_MIN_SCORE=0.25
RAG_MAX_EXTRACTED_CHARS=500000
RAG_MAX_CHUNKS=2500
RAG_MAX_PDF_PAGES=300
RAG_BATCH_SIZE=32
RAG_QDRANT_TIMEOUT=15

# Optional Piper is off in the base Docker image; see docs/operations.md.
TTS_ENABLED=false
PIPER_BINARY=piper
PIPER_MODEL=models/piper/en_US-libritts-high.onnx
PIPER_CONFIG=models/piper/en_US-libritts-high.onnx.json
PIPER_CUDA=true
TTS_TIMEOUT=45
AUDIO_TTL_SECONDS=3600
